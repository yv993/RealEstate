# EverGreen — environment variables
# Copy this file to ".env.local" and fill in values. NEVER commit .env.local.
# In production, add the same keys in Vercel → Project → Settings → Environment Variables.

# ── Supabase (database, auth, storage) ────────────────────────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=            # "Project URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # "anon public" key (safe for the browser)
SUPABASE_SERVICE_ROLE_KEY=           # "service_role" key — SECRET, server only

# ── Site URL (SEO: canonical, sitemap, Open Graph) ────────────────────────
# Your production domain, e.g. https://real-estate.vercel.app or https://evergreen.am
NEXT_PUBLIC_SITE_URL=

# ── Email delivery (Resend — free tier) ───────────────────────────────────
# resend.com → API Keys. Optional: emails are skipped gracefully if unset.
RESEND_API_KEY=
EMAIL_FROM=EverGreen <onboarding@resend.dev>   # use your verified domain once set up
AGENCY_EMAIL=hello@evergreen.am                # where lead notifications are sent

# ── Error monitoring (Sentry — free tier) ─────────────────────────────────
# sentry.io → Project → Settings → Client Keys (DSN). Optional: no-ops if unset.
SENTRY_DSN=

# Note: Vercel Analytics & Speed Insights need NO keys — they turn on
# automatically once the project is deployed on Vercel (enable them in the
# Vercel dashboard under the Analytics / Speed Insights tabs).
