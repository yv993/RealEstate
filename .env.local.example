# EverGreen — environment variables
# Copy this file to ".env.local" and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API). NEVER commit .env.local.

# Public — safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server only, NEVER prefix with NEXT_PUBLIC. Used to write leads.
SUPABASE_SERVICE_ROLE_KEY=
